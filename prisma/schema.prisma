// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== AUTH & USERS =====
model User {
  id                    String    @id @default(cuid())
  phoneNumber           String    @unique
  username              String    @unique
  password              String
  email                 String?
  avatar                String?
  fullName              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Relations
  sessions              Session[]
  orders                Order[]
  addresses             Address[]
  cartItems             CartItem[]
  points                PointTransaction[]
  rewards               UserReward[]
  achievements          UserAchievement[]
  discoveredClues       UserClue[]
  solvedPuzzles         PuzzleAttempt[]
  vipLevel              VIPLevel?         @relation(fields: [vipLevelId], references: [id])
  vipLevelId            String?

  @@index([phoneNumber])
  @@index([username])
}

model Session {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionToken  String    @unique
  expires       DateTime
  createdAt     DateTime  @default(now())

  @@index([userId])
}

// ===== PRODUCTS & VARIANTS =====
model Category {
  id            String    @id @default(cuid())
  name          String    @unique
  nameAr        String
  description   String?
  descriptionAr String?
  products      Product[]
  createdAt     DateTime  @default(now())
}

model Product {
  id            String    @id @default(cuid())
  name          String
  nameAr        String
  description   String    @db.Text
  descriptionAr String    @db.Text
  price         Float
  images        String[]  // JSON array of image URLs
  category      Category  @relation(fields: [categoryId], references: [id])
  categoryId    String
  variants      ProductVariant[]
  drops         Drop[]    @relation("DropProducts")
  clues         Clue[]    @relation("ProductClues")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  isActive      Boolean   @default(true)

  @@index([categoryId])
}

model ProductVariant {
  id            String    @id @default(cuid())
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId     String
  size          String    // XS, S, M, L, XL, XXL or numeric
  color         String?
  sku           String    @unique
  stock         Int       @default(0)
  reserved      Int       @default(0)  // Reserved during checkout
  cartItems     CartItem[]
  orderItems    OrderItem[]
  createdAt     DateTime  @default(now())

  @@unique([productId, size, color])
  @@index([productId])
}

// ===== DROPS =====
model Drop {
  id            String    @id @default(cuid())
  name          String
  nameAr        String
  description   String    @db.Text
  descriptionAr String    @db.Text
  type          String    // "MYSTERY", "FLASH", "NORMAL"
  startAt       DateTime
  endAt         DateTime
  products      Product[] @relation("DropProducts")
  loreChapter   LoreChapter? @relation(fields: [loreChapterId], references: [id])
  loreChapterId String?
  clues         Clue[]    @relation("DropClues")
  puzzles       Puzzle[]  @relation("DropPuzzles")
  status        String    @default("SCHEDULED")  // SCHEDULED, ACTIVE, CLOSED, ARCHIVED
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([type])
  @@index([status])
  @@index([startAt])
}

// ===== LORE & CHAPTERS =====
model LoreChapter {
  id            String    @id @default(cuid())
  title         String
  titleAr       String
  description   String    @db.Text
  descriptionAr String    @db.Text
  content       String    @db.Text
  contentAr     String    @db.Text
  images        String[]  // JSON array
  chapter       Int       @unique  // Chapter number
  drops         Drop[]
  clues         Clue[]    @relation("ChapterClues")
  puzzles       Puzzle[]  @relation("ChapterPuzzles")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ===== CLUES & DISCOVERIES =====
model Clue {
  id            String    @id @default(cuid())
  name          String
  nameAr        String
  secretValue   String    @unique
  description   String?
  descriptionAr String?
  reward        Int       @default(10)  // Points reward
  isActive      Boolean   @default(true)
  chapter       LoreChapter @relation("ChapterClues", fields: [chapterId], references: [id])
  chapterId     String
  drop          Drop?     @relation("DropClues", fields: [dropId], references: [id])
  dropId        String?
  product       Product?  @relation("ProductClues", fields: [productId], references: [id])
  productId     String?
  discoveredBy  UserClue[]
  createdAt     DateTime  @default(now())

  @@index([chapterId])
  @@index([dropId])
}

model UserClue {
  id            String    @id @default(cuid())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  clue          Clue      @relation(fields: [clueId], references: [id], onDelete: Cascade)
  clueId        String
  discoveredAt  DateTime  @default(now())

  @@unique([userId, clueId])
  @@index([userId])
}

// ===== PUZZLES =====
model Puzzle {
  id            String    @id @default(cuid())
  name          String
  nameAr        String
  description   String    @db.Text
  descriptionAr String    @db.Text
  hint          String?
  hintAr        String?
  answer        String    // Hashed or plaintext (server-side only)
  reward        Int       @default(50)  // Points
  chapter       LoreChapter @relation("ChapterPuzzles", fields: [chapterId], references: [id])
  chapterId     String
  drop          Drop?     @relation("DropPuzzles", fields: [dropId], references: [id])
  dropId        String?
  attempts      PuzzleAttempt[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([chapterId])
}

model PuzzleAttempt {
  id            String    @id @default(cuid())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  puzzle        Puzzle    @relation(fields: [puzzleId], references: [id], onDelete: Cascade)
  puzzleId      String
  solved        Boolean   @default(false)
  attemptedAt   DateTime  @default(now())

  @@unique([userId, puzzleId])
  @@index([userId])
}

// ===== CART =====
model CartItem {
  id            String    @id @default(cuid())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  variantId     String
  quantity      Int       @default(1)
  addedAt       DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([userId, variantId])
  @@index([userId])
}

// ===== ORDERS =====
model Order {
  id            String    @id @default(cuid())
  user          User      @relation(fields: [userId], references: [id])
  userId        String
  items         OrderItem[]
  address       Address?  @relation(fields: [addressId], references: [id])
  addressId     String?
  total         Float
  status        String    @default("CONFIRMED")  // CONFIRMED, PREPARING, SHIPPED, DELIVERED, CANCELLED
  paymentMethod String    @default("CASH_ON_DELIVERY")
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id            String    @id @default(cuid())
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId       String
  variant       ProductVariant @relation(fields: [variantId], references: [id])
  variantId     String
  quantity      Int
  price         Float     // Price at time of order
  createdAt     DateTime  @default(now())

  @@index([orderId])
}

// ===== ADDRESSES =====
model Address {
  id            String    @id @default(cuid())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  governorate   String    // Egyptian governorate
  city          String
  street        String
  building      String?
  apartment     String?
  phoneNumber   String
  isDefault     Boolean   @default(false)
  orders        Order[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
}

// ===== POINTS & VIP =====
model PointTransaction {
  id            String    @id @default(cuid())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  amount        Int
  type          String    // "PURCHASE", "PUZZLE", "CLUE", "ACHIEVEMENT", "ADMIN", "REWARD_REDEMPTION"
  description   String?
  reference     String?   // Order ID, Puzzle ID, etc.
  createdAt     DateTime  @default(now())

  @@index([userId])
  @@index([type])
}

model VIPLevel {
  id            String    @id @default(cuid())
  name          String    @unique  // VIP, PRO, ELITE
  nameAr        String
  minPoints     Int
  discount      Float     @default(0)  // Percentage
  perks         String[]  // JSON array
  color         String?
  users         User[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ===== REWARDS =====
model Reward {
  id            String    @id @default(cuid())
  name          String
  nameAr        String
  description   String?
  descriptionAr String?
  cost          Int       // Points cost
  type          String    // "DISCOUNT", "PRODUCT", "EXCLUSIVE_ACCESS", "CUSTOM"
  value         String    // e.g., "10%", "product-id", custom data
  quantity      Int?      // Available quantity
  redeemed      Int       @default(0)
  expiresAt     DateTime?
  isActive      Boolean   @default(true)
  users         UserReward[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model UserReward {
  id            String    @id @default(cuid())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  reward        Reward    @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  rewardId      String
  redeemedAt    DateTime  @default(now())
  usedAt        DateTime?

  @@unique([userId, rewardId])
  @@index([userId])
}

// ===== ACHIEVEMENTS =====
model Achievement {
  id            String    @id @default(cuid())
  name          String    @unique
  nameAr        String
  description   String?
  descriptionAr String?
  icon          String?
  condition     String    // Description of how to unlock
  reward        Int       @default(25)  // Points
  users         UserAchievement[]
  createdAt     DateTime  @default(now())
}

model UserAchievement {
  id            String    @id @default(cuid())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  achievementId String
  unlockedAt    DateTime  @default(now())

  @@unique([userId, achievementId])
  @@index([userId])
}

// ===== SETTINGS =====
model Settings {
  id                    String    @id @default(cuid())
  siteTitle             String    @default("CHAPTER ZERO")
  tagline               String    @default("What is the story?"
  storeOpen             Boolean   @default(true)
  maintenanceMode       Boolean   @default(false)
  showExactStock        Boolean   @default(true)
  shippingCost          Float     @default(0)
  shippingFreeThreshold Float     @default(500)
  updatedAt             DateTime  @updatedAt
}
